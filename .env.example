# ==============================================================================
# == Is the Gävle Goat Burning? - Environment Configuration
# ==============================================================================
#
# Create a `.env` file in the project root by copying this example file.
# Example: `cp .env.example .env`
#
# Then, fill in the necessary values for your setup.

# --- Core Settings ---
SOURCE="https://youtu.be/vDFPpkp9krY"
FIRE_DETECTION_THRESHOLD=0.1
# Decision rule of the classic detector. "frame_fraction" (default): fire if warm AND moving pixels exceed
# FIRE_DETECTION_THRESHOLD of the whole frame. "area_relative" (recommended for production): fire if more than
# AREA_RELATIVE_THRESHOLD of the warm region is moving, so small fires can be detected (see #104/#108).
# WARNING: the default detected 0/11 real fires (#104). RECOMMENDED for production: area_relative.
# Uncomment for production (commented out = code default frame_fraction):
# FIRE_DETECTION_MODE=area_relative
# AREA_RELATIVE_THRESHOLD=0.23
# NOTE: the default FIRE_DETECTION_THRESHOLD=0.1 detected 0/11 real fire clips in the #104 evaluation.
# Recommended for the season (see README, "Recommended in-season settings"): FIRE_DETECTION_MODE=area_relative (FIRE_DETECTION_THRESHOLD is
# ignored there). Older alternative: keep frame_fraction and set FIRE_DETECTION_THRESHOLD=0.05.
# A debounce D needs D+1 consecutive alarmed checks and costs recall (README table, #130); do NOT combine it with the
# frame_fraction 0.05 setting. Optionally combine with a verifier strategy (hybrid_cloud/hybrid_decision; not yet evaluated on these data).
LOGGING="INFO"
VIDEO_OUTPUT=false
CHECKS_PER_SECOND=1.0
# Verifier (Gemini/edge/decision) call limits for the hybrid_* strategies. Minimum seconds between calls (the last
# verdict is reused meanwhile; 0 = call on every positive check) and a hard cap per rolling hour (0 = unlimited;
# at the cap the verifier counts as unavailable and VERIFIER_FAILURE_POLICY applies).
VERIFIER_COOLDOWN_SECONDS=60
VERIFIER_MAX_CALLS_PER_HOUR=0
# What to do when the verifier does not answer (API error, invalid key, quota, timeout) or the call cap is reached.
# An error is never cached: the verifier is asked again on the next check, and only after
# VERIFIER_ERRORS_BEFORE_POLICY consecutive errors (immediately at the cap) the policy applies:
#   alert_unverified  CV detections are alerted, marked "[UNVERIFIED]" in the Discord/email message (default)
#   suppress          no alert; only a CRITICAL log (service signal). NOTE: during an ongoing fire this reports
#                     "no fire", so after FIRE_EXTINGUISHED_DEBOUNCE_SECONDS the fire counts as extinguished
#                     (recording stops, the alert re-arms).
# Errors below VERIFIER_ERRORS_BEFORE_POLICY are inconclusive: the detection state (and both debounces) is kept.
VERIFIER_FAILURE_POLICY=alert_unverified
VERIFIER_ERRORS_BEFORE_POLICY=3

# --- Detection Strategy ---
# How each frame is analysed for fire. Options:
#   classic       Local CV only (HSV colour + motion). No network/model needed.
#   hybrid_cloud  Local CV gatekeeper, escalates to the Gemini API for verification.
#                 (Formerly named "hybrid"; the old value is still auto-migrated.)
#   hybrid_edge   Local CV gatekeeper, escalates to a LOCAL model (ONNX/OpenVINO).
#                 Runs fully offline; requires EDGE__* settings below.
#   gemini        Send every checked frame straight to the Gemini API.
#   gemini_decision  Send every checked frame to the Gemini Decisions API
#                 (gemini-decision-1: calibrated yes/no probability, input tokens only).
#   hybrid_decision  Local CV gatekeeper, escalates to the Decisions API. Recommended over
#                 gemini_decision: continuous 1 fps exceeds the free-tier daily request limit.
DETECTION_STRATEGY=classic

# --- Performance & Streaming ---
OPEN_CL=false
CUDA=false
RECONNECT_DELAY_SECONDS=5
STREAM_INACTIVITY_TIMEOUT=60

# --- Debouncing (Advanced) ---
# Time in seconds an event must be consistently detected before it is triggered.
# Helps prevent false positives from brief flickers.
FIRE_DETECTED_DEBOUNCE_SECONDS=0.0
FIRE_EXTINGUISHED_DEBOUNCE_SECONDS=5.0

# --- Alerts ---
# One alert per fire event; it re-arms once the fire is extinguished (or the stream drops mid-fire).
# Minimum seconds between two alerts. A fire re-detected inside the window is alerted when the window
# ends if it is still burning, so a flickering detection yields a single alert. 0 disables the spacing.
ALERT_COOLDOWN_SECONDS=600

# --- Motion Detection (Advanced) ---
# Pixel intensity change threshold for motion detection.
# Higher values = less sensitivity to motion. Used to filter static false positives.
MOTION_DETECTION_THRESHOLD=25

# --- Gemini (Cloud) Settings ---
# Used by the "gemini" and "hybrid_cloud" strategies.
# GEMINI__API_KEY="your-api-key"
# GEMINI__MODEL="gemini-3.5-flash-lite"
# GEMINI__PROMPT="Analyze this image and determine if there is a visible fire. Ignore purely digital overlays."
# Per-request timeout; a timed-out request counts as a verifier error (see VERIFIER_FAILURE_POLICY).
# GEMINI__TIMEOUT_SECONDS=10

# --- Gemini Decisions API Settings ---
# Used by the "gemini_decision" and "hybrid_decision" strategies (shares GEMINI__API_KEY).
# Requires google-genai >= 3.2; the model is only served on the v1beta API version.
# DECISION__MODEL="gemini-decision-1"
# Minimum calibrated probability P(fire) in [0, 1] to report fire.
# Code default 0.5. RECOMMENDED for hybrid_decision: 0.40 (E3 measurement: 88 % recall, 0/107 false alarms (95% CI upper bound ~3%) on
# the negatives; goat frames were daytime only). Fallback: hybrid_cloud with the default GEMINI__PROMPT.
# DECISION__THRESHOLD=0.40
# DECISION__INSTRUCTIONS="Is there a visible fire in the image? Ignore purely digital overlays."
# Per-request timeout; a timed-out request counts as a verifier error (hybrid_decision: see
# VERIFIER_FAILURE_POLICY; standalone gemini_decision: logged, treated as "no fire").
# DECISION__TIMEOUT_SECONDS=10

# --- Edge (Local Model) Settings ---
# Used by the "hybrid_edge" strategy for fully-offline verification.
# EDGE__MODEL_PATH is required when DETECTION_STRATEGY=hybrid_edge and must point
# to an existing model file.
# EDGE__MODEL_PATH="./models/yolo_v10_n.onnx"
# EDGE__CONFIDENCE_THRESHOLD=0.5
# Hardware backend for inference. Options: auto, cpu, cuda (NVIDIA),
# opencl (AMD/Intel iGPU).
# EDGE__ACCELERATOR=auto
# Side length (pixels) of the square model input (must match the exported model).
# EDGE__INPUT_SIZE=224

# --- Escalation log ---
# hybrid_* strategies: record every frame sent to the verifier as a JPEG plus a line in escalations.jsonl
# (time, file, verifier, verdict fire/no_fire/error/capped, probability, latency, error type, policy). Use it to tune
# thresholds on the live scene. Writes never block detection. The oldest JPEGs are deleted above the size limit.
# ESCALATION_LOG__ENABLED=false
# ESCALATION_LOG__DIRECTORY=./escalation_log
# ESCALATION_LOG__MAX_MB=2000
# ESCALATION_LOG__JPEG_QUALITY=85

# --- Email Settings ---
EMAIL__USE_EMAILS=false
EMAIL__SENDER=""
EMAIL__SENDER_PASSWORD=""
# JSON list (comma-separated values fail at startup), e.g. EMAIL__RECIPIENTS=["a@example.com","b@example.com"]
# Docker --env-file: write it unquoted.
EMAIL__RECIPIENTS=[]
EMAIL__EMAIL_HOST=""
EMAIL__EMAIL_PORT=""

# --- Discord Settings ---
DISCORD__USE_DISCORD=false
DISCORD__HOOKS=[]
# If true, saved video chunks are uploaded to the Discord webhook(s) as they are
# archived around a fire event (requires VIDEO__SAVE_VIDEO_CHUNKS=true). Chunks
# larger than Discord's ~25 MB upload limit are replaced with a text fallback
# message pointing to the local file path.
DISCORD__SEND_VIDEO_CHUNKS=false
# Attach a JPEG of the frame that triggered the alarm to the first alert message
# (downscaled to <= 1280 px wide, JPEG quality 85; the text alert is sent even if encoding fails).
DISCORD__ATTACH_FRAME=true
# Text alert delivery: per-request timeout, attempts per webhook, exponential
# backoff (base doubles each retry, capped at max). HTTP 429 waits for the
# server's Retry-After (also capped at the max delay).
DISCORD__TIMEOUT_SECONDS=10
DISCORD__MAX_ATTEMPTS=5
DISCORD__RETRY_BASE_DELAY_SECONDS=1
DISCORD__RETRY_MAX_DELAY_SECONDS=30

# --- Video Archiving ---
VIDEO__SAVE_VIDEO_CHUNKS=false
VIDEO__VIDEO_OUTPUT_DIRECTORY="./recordings"
# Buffer mode: 'disk' is safer and uses low RAM. 'memory' is faster (less I/O) but uses more RAM.
# 'segments': ffmpeg stream-copies the source (no decode/re-encode) into a ring of short segments in RAM (tmpfs) and
# joins them on fire. Lowest CPU/RAM (best for Raspberry Pi); needs ffmpeg and a tmpfs (Docker: raise --shm-size).
VIDEO__BUFFER_MODE=memory
VIDEO__MEMORY_BUFFER_SECONDS=60
VIDEO__SEGMENTS_DIRECTORY=/dev/shm/goat-ring
VIDEO__SEGMENT_SECONDS=2
VIDEO__VIDEO_CHUNK_LENGTH_SECONDS=300
VIDEO__MAX_VIDEO_CHUNKS=20
VIDEO__CHUNKS_TO_KEEP_AFTER_FIRE=10
VIDEO__RECORD_DURING_FIRE=false
VIDEO__FLUSH_NUM_THREADS=1
VIDEO__FLUSH_THROTTLE_FRAME_INTERVAL=10
VIDEO__FLUSH_THROTTLE_SECONDS=0.01
VIDEO__FLUSH_THROTTLE_ENABLED=false
