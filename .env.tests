# [Test Environment Configuration]
# This file is used exclusively for running the pytest suite.

# Use a non-existent mock source, as the detector will be mocked.
SOURCE="mock://source"
YTDLP_FORMAT="bestvideo/best"
DEFAULT_FRAMERATE=30.0
FIRE_DETECTION_THRESHOLD=0.99
FIRE_DETECTION_MODE=frame_fraction
AREA_RELATIVE_THRESHOLD=0.23
CHECKS_PER_SECOND=5.0
VERIFIER_COOLDOWN_SECONDS=0
VERIFIER_MAX_CALLS_PER_HOUR=0
VERIFIER_FAILURE_POLICY=alert_unverified
VERIFIER_ERRORS_BEFORE_POLICY=3
ALERT_COOLDOWN_SECONDS=600
RECONNECT_DELAY_SECONDS=5
RECONNECT_MAX_DELAY_SECONDS=300
LOGGING=CRITICAL
VIDEO_OUTPUT=false
OPEN_CL=false
CUDA=false

# Disable all external I/O and services by default.
# Individual tests can override these via monkeypatch if needed.
EMAIL__USE_EMAILS=false
EMAIL__SENDER=test@example.com
EMAIL__SENDER_PASSWORD=testpassword
EMAIL__RECIPIENTS=["recipient@example.com"]
EMAIL__EMAIL_HOST=smtp.test.com
EMAIL__EMAIL_PORT=1025
EMAIL__SUBJECT='GOAT ON FIRE!'
EMAIL__MESSAGE='Dear friend... Its time... Its time to Fight Fire With Fire!'

DISCORD__USE_DISCORD=false
DISCORD__HOOKS=["http://test.discord.hook"]
DISCORD__MESSAGE='Dear friend... Its time... Its time to Fight Fire With Fire!'
DISCORD__SEND_VIDEO_CHUNKS=false
DISCORD__FILE_LIMIT_MB=18
DISCORD__ATTACH_FRAME=true
DISCORD__TIMEOUT_SECONDS=10
DISCORD__MAX_ATTEMPTS=5
DISCORD__RETRY_BASE_DELAY_SECONDS=1
DISCORD__RETRY_MAX_DELAY_SECONDS=30
DISCORD__SERVICE_HOOKS=[]
DISCORD__SERVICE_HEARTBEAT_INTERVAL_SECONDS=86400
DISCORD__SERVICE_STREAM_DOWN_WARNING_SECONDS=600

VIDEO__SAVE_VIDEO_CHUNKS=false
VIDEO__VIDEO_OUTPUT_DIRECTORY=/tmp/test-videos
VIDEO__VIDEO_CHUNK_LENGTH_SECONDS=5
VIDEO__MAX_VIDEO_CHUNKS=2
VIDEO__CHUNKS_TO_KEEP_AFTER_FIRE=2
VIDEO__BUFFER_MODE=memory
VIDEO__MEMORY_BUFFER_SECONDS=60
VIDEO__SEGMENTS_DIRECTORY=/tmp/goat-ring-tests
VIDEO__SEGMENT_SECONDS=2
VIDEO__FLUSH_NUM_THREADS=1
VIDEO__FLUSH_THROTTLE_FRAME_INTERVAL=10
VIDEO__FLUSH_THROTTLE_SECONDS=0.01
VIDEO__FLUSH_THROTTLE_ENABLED=false

GEMINI__TIMEOUT_SECONDS=10

# Gemini Decisions API (strategies `gemini_decision` / `hybrid_decision`).
DECISION__MODEL=gemini-decision-1
DECISION__THRESHOLD=0.5
DECISION__TIMEOUT_SECONDS=10

# Edge (local model) verification. The default strategy is `classic`, so the
# `hybrid_edge` model path is left unset; individual tests override these.
# EDGE__MODEL_PATH=
EDGE__CONFIDENCE_THRESHOLD=0.5
EDGE__ACCELERATOR=auto
EDGE__INPUT_SIZE=224
ESCALATION_LOG__ENABLED=false
ESCALATION_LOG__DIRECTORY=./escalation_log_tests
ESCALATION_LOG__MAX_MB=10
ESCALATION_LOG__JPEG_QUALITY=85
