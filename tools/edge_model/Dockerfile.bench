FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip ocl-icd-libopencl1 intel-opencl-icd clinfo libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir numpy "opencv-python-headless>=5,<6" onnxruntime "openvino>=2026,<2027"
WORKDIR /work
CMD ["python", "-m", "tools.edge_model.bench", "--help"]
