# Minimal container for tools/zero_shot_eval/bench.py (#151). Build context: this directory.
#   docker build -f Dockerfile.bench -t zs-bench .
# Keep the work dir (ONNX + JPEGs) OUTSIDE the repository, e.g. ~/zs-bench-work:
#   docker run --rm --cpus 4 -v ~/zs-bench-work:/work:ro zs-bench --model /work/m.onnx --images /work/jpgs --backend ort
#   docker run --rm --cpus 4 -v ~/zs-bench-work:/work:ro zs-bench --model /work/m.onnx --images /work/jpgs --backend cv2 --size 224
FROM python:3.13-slim
WORKDIR /bench
COPY requirements-bench.txt bench.py ./
RUN pip install --no-cache-dir -r requirements-bench.txt
ENTRYPOINT ["python", "/bench/bench.py"]
